# TrustVault Environment Configuration Example
# Copy this file to .env and customize values for your local environment.
# NEVER commit the actual .env file or real secrets to version control.

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=True
APP_NAME=TrustVault
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration (PostgreSQL with psycopg v3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trustvault_dev

# Security & Cryptography (Generate a secure 256-bit key in production)
# Example generation: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration (Private storage path outside web root)
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
